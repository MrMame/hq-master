{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "claude-sonnet-4-6",
  "permissions": {
    "defaultMode": "plan",
    "allow": [
      "Read(./src/**)",
      "Read(./public/**)",
      "Read(./package.json)",
      "Read(./angular.json)",
      "Read(./tsconfig*.json)",
      "Write(./src/**)",
      "Write(./public/**)",
      "Bash(ng serve)",
      "Bash(ng build)",
      "Bash(ng test --*)",
      "Bash(ng lint)",
      "Bash(npx tsc --noEmit)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git add *)",
      "Bash(git commit *)"
    ],
    "deny": [
      "Read(./.env*)",
      "Read(./secrets/**)",
      "Read(./docs/**)",
      "Read(./node_modules/**)",
      "Read(./dist/**)",
      "Read(./build/**)",
      "Bash(npm install *)",
      "Bash(git push *)",
      "Bash(rm -rf *)"
    ]
  }
}